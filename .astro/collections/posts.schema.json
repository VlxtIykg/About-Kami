{
  "$ref": "#/definitions/posts",
  "definitions": {
    "posts": {
      "type": "object",
      "properties": {
        "title": {
          "type": "string",
          "minLength": 1,
          "errorMessage": {
            "minLength": "Title is required"
          }
        },
        "pubDate": {
          "anyOf": [
            {
              "type": "string",
              "format": "date-time"
            },
            {
              "type": "string",
              "format": "date"
            },
            {
              "type": "integer",
              "format": "unix-time"
            }
          ]
        },
        "description": {
          "type": "string",
          "minLength": 10,
          "errorMessage": {
            "minLength": "Description should be at least 10 characters"
          }
        },
        "author": {
          "type": "string",
          "minLength": 1,
          "errorMessage": {
            "minLength": "Author is required"
          }
        },
        "image": {
          "type": "object",
          "properties": {
            "url": {
              "type": "string",
              "format": "uri"
            },
            "alt": {
              "type": "string",
              "minLength": 1,
              "errorMessage": {
                "minLength": "Alt text is required"
              }
            }
          },
          "required": [
            "url",
            "alt"
          ],
          "additionalProperties": false
        },
        "tags": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "minItems": 1,
          "errorMessage": {
            "minItems": "At least one tag is required"
          }
        },
        "$schema": {
          "type": "string"
        }
      },
      "required": [
        "title",
        "pubDate",
        "description",
        "author",
        "image",
        "tags"
      ],
      "additionalProperties": false
    }
  },
  "$schema": "http://json-schema.org/draft-07/schema#"
}